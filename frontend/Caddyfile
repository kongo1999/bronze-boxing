# Public address for the site:
#   - a domain (e.g. studio.example.com) → Caddy gets a Let's Encrypt cert automatically
#   - :80                                → plain HTTP on the droplet's IP (first boot / no domain)
# Set via the SITE_ADDRESS env var (see .env). Defaults to :80.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Sibling handle blocks are mutually exclusive and the most specific
	# matcher wins — /api/* must be a handle, not a bare reverse_proxy,
	# because Caddy orders `handle` first and a matcher-less handle would
	# otherwise swallow API calls too (file_server 405s every POST).
	# The /api prefix is kept intact on purpose — the Go service serves its
	# routes under /api.
	handle /api/* {
		# Live data + auth responses: forbid any intermediary (ISP transparent
		# caches intercept plain HTTP) or browser from caching them.
		header Cache-Control "no-store"
		reverse_proxy api:8080
	}

	# Everything else is the SPA: serve static files, fall back to index.html
	# so client-side routes (e.g. /trainees/123) resolve.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
