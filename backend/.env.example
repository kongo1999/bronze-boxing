# Bronze Boxing API — copy to .env for local dev (native MongoDB, no Docker).
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=bronze-boxing
PORT=8080
CORS_ORIGINS=http://localhost:5173
CURRENCY=$
# Login auth. Empty ADMIN_PASSWORD = no login (open mode, dev default).
# Set both to test the login flow locally; the admin user is synced on boot.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
