# Bronze Boxing API — copy to .env for local dev.
# MongoDB must be a replica set (transactions). Disposable Docker one:
#   docker compose -f docker-compose.test.yml up -d --wait
MONGODB_URI=mongodb://localhost:27027/?replicaSet=rs0
# Native mongod converted to a one-node replica set (see README):
# MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
DB_NAME=bronze-boxing
PORT=8080
CORS_ORIGINS=http://localhost:5173
CURRENCY=$
STUDIO_TZ=Asia/Beirut
# Login auth. Empty ADMIN_PASSWORD = no login (open mode, dev default).
# Set both to test the login flow locally; the admin user is synced on boot.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Emergency switches — leave unset:
# MONGO_ALLOW_STANDALONE=true   # run without transactions (money/stock changes not atomic)
# SKIP_MIGRATION_CHECK=true     # start with pending migrations
