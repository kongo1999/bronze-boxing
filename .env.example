# ── Bronze Boxing · droplet (Docker Compose) configuration ──────────────────
# On the droplet:  cp .env.example .env   then fill in real values.
# This file is committed as a template; the real .env is gitignored.

# MongoDB credentials. The mongo container creates this root user on first boot,
# and the API connects with the same creds (authSource=admin). Changing these
# AFTER the volume exists won't update the stored user — set them before first boot.
MONGO_USER=bronze
MONGO_PASSWORD=CHANGE_ME_to_a_long_random_password
DB_NAME=bronze-boxing

# App login. The admin account is created (and kept in sync) from these on API
# boot — sign in to the app with exactly these credentials. Changing the
# password here and restarting the API rotates it and signs everyone out.
# Leave ADMIN_PASSWORD empty to disable auth entirely (only for a
# private/firewalled droplet — never on the open internet).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_to_a_strong_password

# CORS allow-list. The SPA is served same-origin by Caddy, so this rarely matters.
# Leave * or set to your domain (comma-separated for multiple).
CORS_ORIGINS=*

# Public address for Caddy:
#   - a domain → automatic HTTPS (point an A record at the droplet IP first)
#   - :80      → plain HTTP on the droplet IP (fine for first boot / no domain)
# Example:  SITE_ADDRESS=studio.example.com
SITE_ADDRESS=:80
